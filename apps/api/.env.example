# Core server
NODE_ENV=development
PORT=3001

# PocketBase
POCKETBASE_URL=http://localhost:8090
PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=change-me

# Required for encrypted per-user Coinbase credentials
ORACLE_CREDENTIALS_ENCRYPTION_KEY=replace-with-long-random-secret

# Optional Coinbase credentials (fallback mode if unset)
COINBASE_API_KEY=
COINBASE_API_SECRET=
COINBASE_API_PASSPHRASE=

# Optional Supabase integration
SUPABASE_URL=
SUPABASE_KEY=

# Optional Redis integration
REDIS_URL=

# Optional CORS wildcard (set to * only if intentionally public)
CORS_ORIGIN=
RAILWAY_PUBLIC_DOMAIN=
